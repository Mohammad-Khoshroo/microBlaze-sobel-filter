# ==============================================================================
# Xilinx Vivado & Vitis .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Vivado temporary & generated project directories
# ------------------------------------------------------------------------------
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.runs/
*.gen/
.Xil/

# Vivado journals, logs, dumps, and reports
*.jou
*.log
*.str
*.pb
*.dcp
*.wdb
*.wcfg
*.vcd
webtalk*.log
webtalk*.jou
hs_err_pid*.log
vivado_*.str
vivado_*.zip

# ------------------------------------------------------------------------------
# Vitis / Eclipse workspace & build artifacts
# ------------------------------------------------------------------------------
.metadata/
.analytics
RemoteSystemsTempFiles/
IDE.log
**/_ide/
**/.log/
**/logs/
**/export/

# Object, dependency, and log files generated during C/C++ compilation
*.o
*.d
*.size
*.map
*.build.ui.log

# Allow ELF executable binaries needed by Vivado bitstream association and Vitis
!*.elf

# ------------------------------------------------------------------------------
# Python cache & virtual environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# ------------------------------------------------------------------------------
# OS and Editor artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
